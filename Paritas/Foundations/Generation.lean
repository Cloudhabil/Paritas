/-!
# Paritas.Foundations.Generation
## Algebraic Generation Completeness and Universal Generator Grounding

This module formalizes the mathematical theory of **Algebraic Generation Completeness**.

In mathematical physics and quantum field theory (e.g. Bałaban lattice gauge transformations
and Osterwalder-Schrader reconstruction), operator algebras $\mathcal{A}$ (such as $\mathrm{Poly}$
and $\mathrm{LiePoly}$) must be physically grounded in an explicit set of generator fields
(such as Lie algebra generators $B_i$ and curvature components $F_{\mu\nu}$).

If an algebra is axiomatized abstractly without generation completeness, an adversary can instantiate
the structure with decoupled dummy rings (e.g. constant scalars) that vacuously satisfy the axioms
while containing no gauge degrees of freedom.

### Mathematical Content:
1. `GeneratedTerm m`: Inductive syntax of terms generated by $m$ primitive generator symbols.
2. `evalTerm`: Canonical valuation homomorphism from the free generator syntax into a target algebra.
3. `UniversalGeneratorGrounding`: Certified structure enforcing that every algebraic element
   is an explicit evaluation of physical generators, with linearly independent (injective) basis symbols.
4. `uniqueness_on_generators`: Theorem proving that any two algebra endomorphisms agreeing
   on all primitive generators are identically equal on the entire generated algebra.
-/

namespace Paritas.Foundations

/-- Inductive syntax for terms generated by $m$ primitive generators over $\mathbb{Z}$. -/
inductive GeneratedTerm (m : Nat) : Type
  | const (c : Int) : GeneratedTerm m
  | gen (i : Fin m) : GeneratedTerm m
  | add (t₁ t₂ : GeneratedTerm m) : GeneratedTerm m
  | mul (t₁ t₂ : GeneratedTerm m) : GeneratedTerm m
  | smul (c : Int) (t : GeneratedTerm m) : GeneratedTerm m
deriving DecidableEq

/-- Evaluation of an abstract term into a concrete carrier type equipped with algebraic operations. -/
def evalTerm {Carrier : Type} {m : Nat}
    (embedConst : Int → Carrier)
    (embedGen : Fin m → Carrier)
    (addOp : Carrier → Carrier → Carrier)
    (mulOp : Carrier → Carrier → Carrier)
    (smulOp : Int → Carrier → Carrier) : GeneratedTerm m → Carrier
  | GeneratedTerm.const c => embedConst c
  | GeneratedTerm.gen i => embedGen i
  | GeneratedTerm.add t₁ t₂ =>
      addOp (evalTerm embedConst embedGen addOp mulOp smulOp t₁)
            (evalTerm embedConst embedGen addOp mulOp smulOp t₂)
  | GeneratedTerm.mul t₁ t₂ =>
      mulOp (evalTerm embedConst embedGen addOp mulOp smulOp t₁)
            (evalTerm embedConst embedGen addOp mulOp smulOp t₂)
  | GeneratedTerm.smul c t =>
      smulOp c (evalTerm embedConst embedGen addOp mulOp smulOp t)

/-- A concrete algebraic structure whose carrier is universally grounded in $m$ physical generators. -/
structure UniversalGeneratorGrounding (Carrier : Type) (m : Nat) where
  embedConst : Int → Carrier
  embedGen : Fin m → Carrier
  addOp : Carrier → Carrier → Carrier
  mulOp : Carrier → Carrier → Carrier
  smulOp : Int → Carrier → Carrier
  /-- Basis injectivity: Distinct generator indices produce distinct algebraic elements. -/
  basis_injective : ∀ (i j : Fin m), embedGen i = embedGen j → i = j
  /-- Universal generation theorem: Every element of the carrier is the evaluation of some generator term. -/
  generation_complete : ∀ (x : Carrier), ∃ (t : GeneratedTerm m),
    evalTerm embedConst embedGen addOp mulOp smulOp t = x

/-- Homomorphism compatibility structure for endomorphisms on a generated carrier. -/
structure GroundedHomomorphism {Carrier : Type} {m : Nat}
    (G : UniversalGeneratorGrounding Carrier m) (φ : Carrier → Carrier) : Prop where
  preserves_const : ∀ (c : Int), φ (G.embedConst c) = G.embedConst c
  preserves_add : ∀ (x y : Carrier), φ (G.addOp x y) = G.addOp (φ x) (φ y)
  preserves_mul : ∀ (x y : Carrier), φ (G.mulOp x y) = G.mulOp (φ x) (φ y)
  preserves_smul : ∀ (c : Int) (x : Carrier), φ (G.smulOp c x) = G.smulOp c (φ x)

/-- THEOREM (Agreement on Syntax):
    Two homomorphisms that agree on all generator symbols agree on the evaluation of any syntactic term. -/
theorem evalTerm_homomorphism_agreement {Carrier : Type} {m : Nat}
    (G : UniversalGeneratorGrounding Carrier m)
    (φ ψ : Carrier → Carrier)
    (hφ : GroundedHomomorphism G φ)
    (hψ : GroundedHomomorphism G ψ)
    (h_gen : ∀ (i : Fin m), φ (G.embedGen i) = ψ (G.embedGen i)) :
    ∀ (t : GeneratedTerm m),
      φ (evalTerm G.embedConst G.embedGen G.addOp G.mulOp G.smulOp t) =
      ψ (evalTerm G.embedConst G.embedGen G.addOp G.mulOp G.smulOp t) := by
  intro t
  induction t with
  | const c =>
      dsimp [evalTerm]
      rw [hφ.preserves_const, hψ.preserves_const]
  | gen i =>
      dsimp [evalTerm]
      exact h_gen i
  | add t₁ t₂ ih₁ ih₂ =>
      dsimp [evalTerm]
      rw [hφ.preserves_add, hψ.preserves_add, ih₁, ih₂]
  | mul t₁ t₂ ih₁ ih₂ =>
      dsimp [evalTerm]
      rw [hφ.preserves_mul, hψ.preserves_mul, ih₁, ih₂]
  | smul c t ih =>
      dsimp [evalTerm]
      rw [hφ.preserves_smul, hψ.preserves_smul, ih]

/-- THEOREM (Universal Determination on Generated Carrier):
    If two algebra endomorphisms agree on all physical generators, they are identically equal
    on all elements of the universally generated carrier. -/
theorem uniqueness_on_generators {Carrier : Type} {m : Nat}
    (G : UniversalGeneratorGrounding Carrier m)
    (φ ψ : Carrier → Carrier)
    (hφ : GroundedHomomorphism G φ)
    (hψ : GroundedHomomorphism G ψ)
    (h_gen : ∀ (i : Fin m), φ (G.embedGen i) = ψ (G.embedGen i)) :
    ∀ (x : Carrier), φ x = ψ x := by
  intro x
  obtain ⟨t, ht⟩ := G.generation_complete x
  rw [← ht]
  exact evalTerm_homomorphism_agreement G φ ψ hφ hψ h_gen t

end Paritas.Foundations
